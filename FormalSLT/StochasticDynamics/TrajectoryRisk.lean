import FormalSLT.StochasticDynamics.MarkovRisk

/-!
# Prequential risk for history-dependent trajectory kernels

This file extends the finite-state trajectory-risk layer from time-homogeneous
Markov transitions to arbitrary prefix-dependent kernels.  At time `n`, the
kernel may inspect the entire prefix indexed by `Finset.Iic n`, and the score
may depend on that prefix and the next state.  For any score taking values in
`[0, 1]`, the observed score minus its kernel-conditional risk is an adapted,
conditionally centered innovation with conditional second moment at most
`1 / 4`.

The existing Markov API remains unchanged.  The final bridge lemmas identify
its path law, squared loss, conditional risk, and innovation as special cases
of the prefix-dependent definitions.
-/

open Filter Finset Function MeasureTheory ProbabilityTheory
open scoped BigOperators ENNReal NNReal Topology

namespace FormalSLT.StochasticDynamics

noncomputable section

variable {Z : Type*} [Fintype Z] [MeasurableSpace Z] [MeasurableSingletonClass Z]

/-- A one-step score which may inspect the complete trajectory prefix before
scoring the next state. -/
abbrev TrajectoryScore (Z : Type*) :=
  (n : ℕ) → ((i : Finset.Iic n) → Z) → Z → ℝ

/-- The Ionescu--Tulcea path law generated by a deterministic initial state and
an arbitrary family of prefix-dependent Markov kernels. -/
def trajectoryMeasure
    (κ : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    [∀ n, IsMarkovKernel (κ n)] (x0 : Z) : Measure (ℕ → Z) :=
  Kernel.traj (X := fun _ : ℕ ↦ Z) κ 0 (fun _ ↦ x0)

instance trajectoryMeasure.instIsProbabilityMeasure
    (κ : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    [∀ n, IsMarkovKernel (κ n)] (x0 : Z) :
    IsProbabilityMeasure (trajectoryMeasure κ x0) := by
  unfold trajectoryMeasure
  infer_instance

/-- The score observed after extending a path prefix by its next state. -/
def observedTrajectoryScore (score : TrajectoryScore Z)
    (n : ℕ) (x : ℕ → Z) : ℝ :=
  score n (Preorder.frestrictLe n x) (x (n + 1))

/-- The one-step score averaged against the kernel selected by the observed
prefix. -/
def conditionalTrajectoryRisk
    (κ : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    (score : TrajectoryScore Z) (n : ℕ) (x : ℕ → Z) : ℝ :=
  ∫ y, score n (Preorder.frestrictLe n x) y
    ∂κ n (Preorder.frestrictLe n x)

omit [Fintype Z] [MeasurableSingletonClass Z] in
private lemma stronglyMeasurable_piLE_of_prefix_trajectory
    (n : ℕ) (g : ((i : Finset.Iic n) → Z) → ℝ) (hg : StronglyMeasurable g) :
    StronglyMeasurable[Filtration.piLE (X := fun _ : ℕ ↦ Z) n]
      (fun x ↦ g (Preorder.frestrictLe n x)) := by
  rw [Filtration.piLE_eq_comap_frestrictLe]
  exact hg.comp_measurable (comap_measurable _)

/-- The observed score at step `n` is measurable with respect to the path
through coordinate `n + 1`. -/
lemma stronglyMeasurable_observedTrajectoryScore_succ
    (score : TrajectoryScore Z) (n : ℕ) :
    StronglyMeasurable[Filtration.piLE (X := fun _ : ℕ ↦ Z) (n + 1)]
      (observedTrajectoryScore score n) := by
  let g : ((i : Finset.Iic (n + 1)) → Z) → ℝ := fun u ↦
    score n
      (Preorder.frestrictLe₂ (π := fun _ : ℕ ↦ Z) (Nat.le_succ n) u)
      (u ⟨n + 1, Finset.mem_Iic.mpr le_rfl⟩)
  have hg : StronglyMeasurable g := (measurable_of_countable g).stronglyMeasurable
  have hmeas := stronglyMeasurable_piLE_of_prefix_trajectory (n + 1) g hg
  change StronglyMeasurable[Filtration.piLE (X := fun _ : ℕ ↦ Z) (n + 1)]
    (fun x ↦ score n (Preorder.frestrictLe n x) (x (n + 1)))
  convert hmeas using 1
  funext x
  simp only [g, Preorder.frestrictLe_apply]
  congr 1

lemma measurable_observedTrajectoryScore
    (score : TrajectoryScore Z) (n : ℕ) :
    Measurable (observedTrajectoryScore score n) :=
  ((stronglyMeasurable_observedTrajectoryScore_succ score n).mono
    ((Filtration.piLE (X := fun _ : ℕ ↦ Z)).le (n + 1))).measurable

omit [Fintype Z] [MeasurableSpace Z] [MeasurableSingletonClass Z] in
lemma observedTrajectoryScore_mem_Icc
    {score : TrajectoryScore Z}
    (hscore : ∀ n u y, score n u y ∈ Set.Icc (0 : ℝ) 1)
    (n : ℕ) (x : ℕ → Z) :
    observedTrajectoryScore score n x ∈ Set.Icc (0 : ℝ) 1 :=
  hscore n (Preorder.frestrictLe n x) (x (n + 1))

lemma integrable_observedTrajectoryScore
    {κ : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z}
    [∀ n, IsMarkovKernel (κ n)] {x0 : Z} {score : TrajectoryScore Z}
    (hscore : ∀ n u y, score n u y ∈ Set.Icc (0 : ℝ) 1)
    (n : ℕ) :
    Integrable (observedTrajectoryScore score n) (trajectoryMeasure κ x0) := by
  refine Integrable.of_bound
    (measurable_observedTrajectoryScore score n).aestronglyMeasurable 1 ?_
  exact Filter.Eventually.of_forall fun x ↦ by
    rw [Real.norm_eq_abs, abs_of_nonneg
      (observedTrajectoryScore_mem_Icc hscore n x).1]
    exact (observedTrajectoryScore_mem_Icc hscore n x).2

omit [Fintype Z] [MeasurableSingletonClass Z] in
/-- Under a trajectory continuation from prefix `u`, coordinate `n + 1` has
exactly the law selected by the prefix-dependent kernel `κ n u`. -/
lemma map_trajectory_next
    (κ : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    [∀ n, IsMarkovKernel (κ n)] (n : ℕ)
    (u : (i : Finset.Iic n) → Z) :
    (Kernel.traj (X := fun _ : ℕ ↦ Z) κ n u).map
        (fun x ↦ x (n + 1)) = κ n u := by
  rw [← Kernel.map_apply
    (Kernel.traj (X := fun _ : ℕ ↦ Z) κ n)
    (measurable_pi_apply (n + 1)) u]
  rw [Kernel.map_traj_succ_self]

/-- Integrating the observed score against a trajectory continuation is the
kernel-conditional risk associated with its supplied prefix. -/
lemma integral_observedTrajectoryScore_traj
    (κ : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    [∀ n, IsMarkovKernel (κ n)]
    (score : TrajectoryScore Z) (n : ℕ)
    (u : (i : Finset.Iic n) → Z) :
    ∫ x, observedTrajectoryScore score n x
        ∂Kernel.traj (X := fun _ : ℕ ↦ Z) κ n u =
      ∫ y, score n u y ∂κ n u := by
  let μn : Measure (ℕ → Z) :=
    Kernel.traj (X := fun _ : ℕ ↦ Z) κ n u
  calc
    ∫ x, observedTrajectoryScore score n x ∂μn =
        ∫ x, observedTrajectoryScore score n
          (Function.updateFinset x (Finset.Iic n) u) ∂μn := by
      exact Kernel.integral_traj (X := fun _ : ℕ ↦ Z) u
        (measurable_observedTrajectoryScore score n).aestronglyMeasurable
    _ = ∫ x, score n u (x (n + 1)) ∂μn := by
      apply integral_congr_ae
      exact Filter.Eventually.of_forall fun x ↦ by
        unfold observedTrajectoryScore
        change score n (Preorder.frestrictLe n
            (Function.updateFinset x (Finset.Iic n) u))
          (Function.updateFinset x (Finset.Iic n) u (n + 1)) =
            score n u (x (n + 1))
        rw [show Preorder.frestrictLe n
            (Function.updateFinset x (Finset.Iic n) u) = u by
          funext i
          simp [Preorder.frestrictLe_apply, Function.updateFinset]]
        simp [Function.updateFinset, Finset.mem_Iic]
    _ = ∫ y, score n u y
          ∂Measure.map (fun x : ℕ → Z ↦ x (n + 1)) μn := by
      symm
      exact integral_map
        (measurable_pi_apply (n + 1)).aemeasurable
        (measurable_of_countable (score n u)).aestronglyMeasurable
    _ = ∫ y, score n u y ∂κ n u := by
      rw [show Measure.map (fun x : ℕ → Z ↦ x (n + 1)) μn = κ n u by
        exact map_trajectory_next κ n u]

/-- The trajectory construction determines the exact conditional expectation
of the next score from the whole observed prefix. -/
theorem observedTrajectoryScore_condExp
    (κ : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    [∀ n, IsMarkovKernel (κ n)] (x0 : Z)
    (score : TrajectoryScore Z)
    (hscore : ∀ n u y, score n u y ∈ Set.Icc (0 : ℝ) 1)
    (n : ℕ) :
    (trajectoryMeasure κ x0)[observedTrajectoryScore score n |
        Filtration.piLE (X := fun _ : ℕ ↦ Z) n] =ᵐ[trajectoryMeasure κ x0]
      conditionalTrajectoryRisk κ score n := by
  have hcond := Kernel.condExp_traj
    (X := fun _ : ℕ ↦ Z) (κ := κ)
    (a := 0) (b := n) (Nat.zero_le n)
    (integrable_observedTrajectoryScore (κ := κ) (x0 := x0) hscore n)
  unfold trajectoryMeasure
  filter_upwards [hcond] with x hx
  rw [hx, integral_observedTrajectoryScore_traj κ score n]
  rfl

lemma stronglyMeasurable_conditionalTrajectoryRisk
    (κ : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    (score : TrajectoryScore Z) (n : ℕ) :
    StronglyMeasurable[Filtration.piLE (X := fun _ : ℕ ↦ Z) n]
      (conditionalTrajectoryRisk κ score n) := by
  let g : ((i : Finset.Iic n) → Z) → ℝ := fun u ↦
    ∫ y, score n u y ∂κ n u
  have hg : StronglyMeasurable g := (measurable_of_countable g).stronglyMeasurable
  change StronglyMeasurable[Filtration.piLE (X := fun _ : ℕ ↦ Z) n]
    (fun x ↦ ∫ y, score n (Preorder.frestrictLe n x) y
      ∂κ n (Preorder.frestrictLe n x))
  simpa [g] using stronglyMeasurable_piLE_of_prefix_trajectory n g hg

lemma conditionalTrajectoryRisk_mem_Icc
    (κ : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    [∀ n, IsMarkovKernel (κ n)] {score : TrajectoryScore Z}
    (hscore : ∀ n u y, score n u y ∈ Set.Icc (0 : ℝ) 1)
    (n : ℕ) (x : ℕ → Z) :
    conditionalTrajectoryRisk κ score n x ∈ Set.Icc (0 : ℝ) 1 := by
  let u := Preorder.frestrictLe n x
  let rowScore : Z → ℝ := fun y ↦ score n u y
  have hrow_int : Integrable rowScore (κ n u) := Integrable.of_finite
  constructor
  · exact integral_nonneg_of_ae
      (Filter.Eventually.of_forall fun y ↦ (hscore n u y).1)
  · have hle := integral_mono_ae hrow_int (integrable_const (1 : ℝ))
        (Filter.Eventually.of_forall fun y ↦ (hscore n u y).2)
    simpa [conditionalTrajectoryRisk, u, rowScore] using hle

lemma integrable_conditionalTrajectoryRisk
    {κ : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z}
    [∀ n, IsMarkovKernel (κ n)] {x0 : Z} {score : TrajectoryScore Z}
    (hscore : ∀ n u y, score n u y ∈ Set.Icc (0 : ℝ) 1)
    (n : ℕ) :
    Integrable (conditionalTrajectoryRisk κ score n) (trajectoryMeasure κ x0) := by
  have hrisk_meas : StronglyMeasurable (conditionalTrajectoryRisk κ score n) :=
    (stronglyMeasurable_conditionalTrajectoryRisk κ score n).mono
      ((Filtration.piLE (X := fun _ : ℕ ↦ Z)).le n)
  refine Integrable.of_bound hrisk_meas.aestronglyMeasurable 1 ?_
  exact Filter.Eventually.of_forall fun x ↦ by
    rw [Real.norm_eq_abs, abs_of_nonneg
      (conditionalTrajectoryRisk_mem_Icc κ hscore n x).1]
    exact (conditionalTrajectoryRisk_mem_Icc κ hscore n x).2

/-- Observed score minus its exact prefix-conditional risk. -/
def trajectoryRiskInnovation
    (κ : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    (score : TrajectoryScore Z) (n : ℕ) (x : ℕ → Z) : ℝ :=
  observedTrajectoryScore score n x - conditionalTrajectoryRisk κ score n x

lemma trajectoryRiskInnovation_incrementAdapted
    (κ : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    (score : TrajectoryScore Z) :
    AnytimeValid.IncrementAdapted
      (Filtration.piLE (X := fun _ : ℕ ↦ Z))
      (trajectoryRiskInnovation κ score) := by
  intro n
  exact (stronglyMeasurable_observedTrajectoryScore_succ score n).sub
    ((stronglyMeasurable_conditionalTrajectoryRisk κ score n).mono
      ((Filtration.piLE (X := fun _ : ℕ ↦ Z)).mono (Nat.le_succ n)))

lemma measurable_trajectoryRiskInnovation
    (κ : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    (score : TrajectoryScore Z) (n : ℕ) :
    Measurable (trajectoryRiskInnovation κ score n) :=
  ((trajectoryRiskInnovation_incrementAdapted κ score) n).mono
      ((Filtration.piLE (X := fun _ : ℕ ↦ Z)).le (n + 1)) |>.measurable

lemma abs_trajectoryRiskInnovation_le_one
    (κ : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    [∀ n, IsMarkovKernel (κ n)] {score : TrajectoryScore Z}
    (hscore : ∀ n u y, score n u y ∈ Set.Icc (0 : ℝ) 1)
    (n : ℕ) (x : ℕ → Z) :
    |trajectoryRiskInnovation κ score n x| ≤ 1 := by
  have hobserved := observedTrajectoryScore_mem_Icc hscore n x
  have hrisk := conditionalTrajectoryRisk_mem_Icc κ hscore n x
  rcases hobserved with ⟨hobserved0, hobserved1⟩
  rcases hrisk with ⟨hrisk0, hrisk1⟩
  rw [abs_le]
  unfold trajectoryRiskInnovation
  constructor <;> linarith

lemma integrable_trajectoryRiskInnovation
    {κ : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z}
    [∀ n, IsMarkovKernel (κ n)] {x0 : Z} {score : TrajectoryScore Z}
    (hscore : ∀ n u y, score n u y ∈ Set.Icc (0 : ℝ) 1)
    (n : ℕ) :
    Integrable (trajectoryRiskInnovation κ score n) (trajectoryMeasure κ x0) := by
  exact (integrable_observedTrajectoryScore (κ := κ) (x0 := x0) hscore n).sub
    (integrable_conditionalTrajectoryRisk (κ := κ) (x0 := x0) hscore n)

/-- The prefix-dependent trajectory innovation is conditionally centered under
the path law generated by the same kernels. -/
theorem trajectoryRiskInnovation_condExp_eq_zero
    (κ : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    [∀ n, IsMarkovKernel (κ n)] (x0 : Z) {score : TrajectoryScore Z}
    (hscore : ∀ n u y, score n u y ∈ Set.Icc (0 : ℝ) 1)
    (n : ℕ) :
    (trajectoryMeasure κ x0)[trajectoryRiskInnovation κ score n |
        Filtration.piLE (X := fun _ : ℕ ↦ Z) n] =ᵐ[trajectoryMeasure κ x0] 0 := by
  have hobserved_int :=
    integrable_observedTrajectoryScore (κ := κ) (x0 := x0) hscore n
  have hrisk_int :=
    integrable_conditionalTrajectoryRisk (κ := κ) (x0 := x0) hscore n
  have hsub := condExp_sub hobserved_int hrisk_int
    (Filtration.piLE (X := fun _ : ℕ ↦ Z) n)
  have hsub' :
      (trajectoryMeasure κ x0)[trajectoryRiskInnovation κ score n |
          Filtration.piLE (X := fun _ : ℕ ↦ Z) n] =ᵐ[trajectoryMeasure κ x0]
        (trajectoryMeasure κ x0)[observedTrajectoryScore score n |
            Filtration.piLE (X := fun _ : ℕ ↦ Z) n] -
          (trajectoryMeasure κ x0)[conditionalTrajectoryRisk κ score n |
            Filtration.piLE (X := fun _ : ℕ ↦ Z) n] := by
    rw [show trajectoryRiskInnovation κ score n =
        observedTrajectoryScore score n - conditionalTrajectoryRisk κ score n by rfl]
    exact hsub
  have hobserved := observedTrajectoryScore_condExp κ x0 score hscore n
  have hrisk :
      (trajectoryMeasure κ x0)[conditionalTrajectoryRisk κ score n |
          Filtration.piLE (X := fun _ : ℕ ↦ Z) n] =
      conditionalTrajectoryRisk κ score n :=
    condExp_of_stronglyMeasurable
      ((Filtration.piLE (X := fun _ : ℕ ↦ Z)).le n)
      (stronglyMeasurable_conditionalTrajectoryRisk κ score n) hrisk_int
  filter_upwards [hsub', hobserved] with x hsubx hobservedx
  rw [hsubx]
  change (trajectoryMeasure κ x0)[observedTrajectoryScore score n |
      Filtration.piLE (X := fun _ : ℕ ↦ Z) n] x -
    (trajectoryMeasure κ x0)[conditionalTrajectoryRisk κ score n |
      Filtration.piLE (X := fun _ : ℕ ↦ Z) n] x = 0
  rw [hobservedx, hrisk]
  simp

/-- A `[0,1]` prefix-dependent score has conditional centered second moment at
most `1 / 4`, with no stationarity or finite-memory assumption on the kernels. -/
theorem trajectoryRiskInnovation_condSecondMoment_le_one_fourth
    (κ : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    [∀ n, IsMarkovKernel (κ n)] (x0 : Z) {score : TrajectoryScore Z}
    (hscore : ∀ n u y, score n u y ∈ Set.Icc (0 : ℝ) 1)
    (n : ℕ) :
    (trajectoryMeasure κ x0)[fun x ↦ (trajectoryRiskInnovation κ score n x) ^ 2 |
        Filtration.piLE (X := fun _ : ℕ ↦ Z) n] ≤ᵐ[trajectoryMeasure κ x0]
      fun _ ↦ (1 / 4 : ℝ) := by
  let μ := trajectoryMeasure κ x0
  let ℱ := Filtration.piLE (X := fun _ : ℕ ↦ Z)
  let L := observedTrajectoryScore score n
  have hL_Icc : ∀ᵐ x ∂μ, L x ∈ Set.Icc (0 : ℝ) 1 :=
    Filter.Eventually.of_forall fun x ↦ observedTrajectoryScore_mem_Icc hscore n x
  have hL_memLp : MemLp L 2 μ :=
    memLp_of_bounded hL_Icc
      (measurable_observedTrajectoryScore score n).aestronglyMeasurable 2
  have hL_cond :
      μ[L | ℱ n] =ᵐ[μ] conditionalTrajectoryRisk κ score n := by
    simpa [μ, ℱ, L] using observedTrajectoryScore_condExp κ x0 score hscore n
  have hinnovation_eq_condVar :
      μ[fun x ↦ (trajectoryRiskInnovation κ score n x) ^ 2 | ℱ n] =ᵐ[μ]
        Var[L; μ | ℱ n] := by
    unfold ProbabilityTheory.condVar
    refine condExp_congr_ae ?_
    filter_upwards [hL_cond] with x hx
    change (L x - conditionalTrajectoryRisk κ score n x) ^ 2 =
      (L x - μ[L | ℱ n] x) ^ 2
    rw [hx]
  have hcondVar_formula :=
    condVar_ae_eq_condExp_sq_sub_sq_condExp (ℱ.le n) hL_memLp
  have hL_sq_le : ∀ᵐ x ∂μ, L x ^ 2 ≤ L x :=
    hL_Icc.mono fun x hx ↦ by
      rcases hx with ⟨hx0, hx1⟩
      nlinarith [sq_nonneg (L x)]
  have hcond_sq_le := condExp_mono (m := ℱ n) (μ := μ)
    hL_memLp.integrable_sq
    (integrable_observedTrajectoryScore (κ := κ) (x0 := x0) hscore n)
    hL_sq_le
  filter_upwards [hinnovation_eq_condVar, hcondVar_formula,
    hcond_sq_le, hL_cond] with x hinnovation hformula hsq hmean
  rw [hinnovation, hformula]
  change μ[fun x ↦ L x ^ 2 | ℱ n] x - (μ[L | ℱ n] x) ^ 2 ≤ 1 / 4
  have hrisk := conditionalTrajectoryRisk_mem_Icc κ hscore n x
  rw [hmean] at hsq ⊢
  nlinarith [sq_nonneg (conditionalTrajectoryRisk κ score n x - 1 / 2)]

/-- The Markov path measure is the specialization of `trajectoryMeasure` to
the current-state `prefixKernel`. -/
lemma trajectoryMeasure_prefixKernel_eq_markovPathMeasure
    (P : Z → PMF Z) (x0 : Z) :
    trajectoryMeasure (prefixKernel P) x0 = markovPathMeasure P x0 := rfl

/-- Squared Markov loss as a prefix-dependent trajectory score. -/
def markovSquaredTrajectoryScore (f q : Z → ℝ) : TrajectoryScore Z :=
  fun n u y ↦ transitionSquaredLoss f q
    (u ⟨n, Finset.mem_Iic.mpr le_rfl⟩) y

omit [Fintype Z] [MeasurableSpace Z] [MeasurableSingletonClass Z] in
lemma observedTrajectoryScore_markovSquaredTrajectoryScore
    (f q : Z → ℝ) (n : ℕ) (x : ℕ → Z) :
    observedTrajectoryScore (markovSquaredTrajectoryScore f q) n x =
      pathSquaredLoss f q n x := rfl

lemma conditionalTrajectoryRisk_markovSquaredTrajectoryScore
    (P : Z → PMF Z) (f q : Z → ℝ) (n : ℕ) (x : ℕ → Z) :
    conditionalTrajectoryRisk (prefixKernel P)
        (markovSquaredTrajectoryScore f q) n x =
      conditionalSquaredRisk P f q n x := by
  rfl

lemma trajectoryRiskInnovation_markovSquaredTrajectoryScore
    (P : Z → PMF Z) (f q : Z → ℝ) (n : ℕ) (x : ℕ → Z) :
    trajectoryRiskInnovation (prefixKernel P)
        (markovSquaredTrajectoryScore f q) n x =
      markovRiskInnovation P f q n x := by
  rfl

/-- The original homogeneous-Markov squared-loss conditional-expectation
theorem is an instance of the prefix-dependent trajectory theorem. -/
theorem pathSquaredLoss_condExp_via_trajectory
    (P : Z → PMF Z) (x0 : Z) (f q : Z → ℝ)
    (hf : ∀ z, f z ∈ Set.Icc (0 : ℝ) 1)
    (hq : ∀ z, q z ∈ Set.Icc (0 : ℝ) 1)
    (n : ℕ) :
    (markovPathMeasure P x0)[pathSquaredLoss f q n |
        Filtration.piLE (X := fun _ : ℕ ↦ Z) n] =ᵐ[markovPathMeasure P x0]
      conditionalSquaredRisk P f q n := by
  have hscore : ∀ k u y,
      markovSquaredTrajectoryScore f q k u y ∈ Set.Icc (0 : ℝ) 1 := by
    intro k u y
    exact transitionSquaredLoss_mem_Icc hf hq
      (u ⟨k, Finset.mem_Iic.mpr le_rfl⟩) y
  change
    (trajectoryMeasure (prefixKernel P) x0)[
        observedTrajectoryScore (markovSquaredTrajectoryScore f q) n |
          Filtration.piLE (X := fun _ : ℕ ↦ Z) n] =ᵐ[
      trajectoryMeasure (prefixKernel P) x0]
      conditionalTrajectoryRisk (prefixKernel P)
        (markovSquaredTrajectoryScore f q) n
  exact observedTrajectoryScore_condExp (prefixKernel P) x0
    (markovSquaredTrajectoryScore f q) hscore n

end

end FormalSLT.StochasticDynamics
