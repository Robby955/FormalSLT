import FormalSLT.StochasticDynamics.TrajectoryRisk
import FormalSLT.StochasticDynamics.MarkovPACBayes
import FormalSLT.PACBayes.TimeUniformTiltMixture

/-!
# Time-uniform PAC-Bayes risk for prefix-dependent trajectories

This module transfers the generic finite hypothesis--tilt sub-Gamma master
process to the path law generated by arbitrary prefix-dependent kernels.  The
finite score catalog is declared before the path is observed, but each score
may inspect the complete observed prefix before scoring the next state.  Thus
the catalog may contain predeclared online prediction rules rather than only
fixed last-state predictors.

One measurable event controls every positive time, every posterior PMF on the
finite score catalog, and every atom of a predeclared finite weighted tilt
catalog.  The target is the posterior average of the prefix-conditional risks
encountered along the realized path.  It is not a stationary or long-run risk.

The concentration step is not reproved here.  The adapter uses the existing
finite hypothesis--tilt e-process, Ville inequality, and finite
Donsker--Varadhan compiler with the sharp universal conditional-variance bound
`1 / 4` supplied by `TrajectoryRisk`.
-/

open Filter Finset Function MeasureTheory ProbabilityTheory
open FormalSLT.AnytimeValid
open FormalSLT.PACBayesKL
open scoped BigOperators ENNReal NNReal Topology

namespace FormalSLT.StochasticDynamics

noncomputable section

local instance trajectoryPACBayesPropDecidable (p : Prop) : Decidable p :=
  Classical.propDecidable p

variable {ι τ Z : Type*}
  [Fintype ι] [DecidableEq ι] [Nonempty ι]
  [Fintype τ] [DecidableEq τ] [Nonempty τ]
  [Fintype Z] [MeasurableSpace Z] [MeasurableSingletonClass Z]

/-- Prefix-conditional risk minus the next observed score.  This sign gives an
upper certificate on latent conditional risk. -/
def trajectoryRiskShortfall
    (K : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    (score : TrajectoryScore Z) (n : ℕ) (x : ℕ → Z) : ℝ :=
  -trajectoryRiskInnovation K score n x

/-- Running average of a trajectory score observed along one path. -/
def trajectoryEmpiricalPrequentialRisk
    (score : TrajectoryScore Z) (n : ℕ) (x : ℕ → Z) : ℝ :=
  runningMean (observedTrajectoryScore score) n x

/-- Running average of the one-step prefix-conditional risks encountered along
one path. -/
def trajectoryAverageConditionalRisk
    (K : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    (score : TrajectoryScore Z) (n : ℕ) (x : ℕ → Z) : ℝ :=
  runningMean (conditionalTrajectoryRisk K score) n x

/-- Posterior average of the observed prequential risks of a finite catalog of
prefix-dependent scores. -/
def trajectoryPosteriorEmpiricalPrequentialRisk
    (score : ι → TrajectoryScore Z) (posterior : ι → ℝ)
    (n : ℕ) (x : ℕ → Z) : ℝ :=
  posteriorAverage posterior
    (fun i ↦ trajectoryEmpiricalPrequentialRisk (score i) n x)

/-- Posterior average of the encountered prefix-conditional risks. -/
def trajectoryPosteriorAverageConditionalRisk
    (K : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    (score : ι → TrajectoryScore Z) (posterior : ι → ℝ)
    (n : ℕ) (x : ℕ → Z) : ℝ :=
  posteriorAverage posterior
    (fun i ↦ trajectoryAverageConditionalRisk K (score i) n x)

omit [Fintype ι] [DecidableEq ι] [Nonempty ι]
  [Fintype τ] [DecidableEq τ] [Nonempty τ]
  [Fintype Z] [MeasurableSingletonClass Z] in
/-- The shortfall running mean is conditional risk minus observed risk. -/
theorem runningMean_trajectoryRiskShortfall
    (K : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    (score : TrajectoryScore Z) (n : ℕ) (x : ℕ → Z) :
    runningMean (trajectoryRiskShortfall K score) n x =
      trajectoryAverageConditionalRisk K score n x -
        trajectoryEmpiricalPrequentialRisk score n x := by
  rw [show trajectoryRiskShortfall K score =
      fun k x ↦ -trajectoryRiskInnovation K score k x by rfl]
  rw [runningMean_neg]
  unfold trajectoryAverageConditionalRisk trajectoryEmpiricalPrequentialRisk
    trajectoryRiskInnovation runningMean runningSum
  rw [Finset.sum_sub_distrib]
  ring

omit [DecidableEq ι] [Nonempty ι]
  [Fintype τ] [DecidableEq τ] [Nonempty τ]
  [Fintype Z] [MeasurableSingletonClass Z] in
/-- Posterior averaging preserves the conditional-minus-observed identity. -/
theorem posteriorAverage_runningMean_trajectoryRiskShortfall
    (K : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    (score : ι → TrajectoryScore Z) (posterior : ι → ℝ)
    (n : ℕ) (x : ℕ → Z) :
    posteriorAverage posterior
        (fun i ↦ runningMean (trajectoryRiskShortfall K (score i)) n x) =
      trajectoryPosteriorAverageConditionalRisk K score posterior n x -
        trajectoryPosteriorEmpiricalPrequentialRisk score posterior n x := by
  unfold trajectoryPosteriorAverageConditionalRisk
    trajectoryPosteriorEmpiricalPrequentialRisk posteriorAverage
  rw [← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro i _hi
  change posterior i * runningMean (trajectoryRiskShortfall K (score i)) n x =
    posterior i * trajectoryAverageConditionalRisk K (score i) n x -
      posterior i * trajectoryEmpiricalPrequentialRisk (score i) n x
  rw [runningMean_trajectoryRiskShortfall]
  ring

omit [Fintype ι] [DecidableEq ι] [Nonempty ι]
  [Fintype τ] [DecidableEq τ] [Nonempty τ] in
lemma trajectoryRiskShortfall_incrementAdapted
    (K : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    (score : TrajectoryScore Z) :
    IncrementAdapted (Filtration.piLE (X := fun _ : ℕ ↦ Z))
      (trajectoryRiskShortfall K score) := by
  exact incrementAdapted_neg (trajectoryRiskInnovation_incrementAdapted K score)

omit [Fintype ι] [DecidableEq ι] [Nonempty ι]
  [Fintype τ] [DecidableEq τ] [Nonempty τ] in
lemma measurable_trajectoryRiskShortfall
    (K : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    (score : TrajectoryScore Z) (n : ℕ) :
    Measurable (trajectoryRiskShortfall K score n) :=
  (measurable_trajectoryRiskInnovation K score n).neg

omit [Fintype ι] [DecidableEq ι] [Nonempty ι]
  [Fintype τ] [DecidableEq τ] [Nonempty τ] in
lemma integrable_trajectoryRiskShortfall
    {K : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z}
    [∀ n, IsMarkovKernel (K n)] {x0 : Z} {score : TrajectoryScore Z}
    (hscore : ∀ n u y, score n u y ∈ Set.Icc (0 : ℝ) 1) (k : ℕ) :
    Integrable (trajectoryRiskShortfall K score k) (trajectoryMeasure K x0) :=
  (integrable_trajectoryRiskInnovation
    (κ := K) (x0 := x0) hscore k).neg

omit [Fintype ι] [DecidableEq ι] [Nonempty ι]
  [Fintype τ] [DecidableEq τ] [Nonempty τ] in
lemma abs_trajectoryRiskShortfall_le_one
    (K : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    [∀ n, IsMarkovKernel (K n)] {score : TrajectoryScore Z}
    (hscore : ∀ n u y, score n u y ∈ Set.Icc (0 : ℝ) 1)
    (k : ℕ) (x : ℕ → Z) :
    |trajectoryRiskShortfall K score k x| ≤ 1 := by
  simpa [trajectoryRiskShortfall, abs_neg] using
    abs_trajectoryRiskInnovation_le_one K hscore k x

omit [Fintype ι] [DecidableEq ι] [Nonempty ι]
  [Fintype τ] [DecidableEq τ] [Nonempty τ] in
/-- The risk shortfall is centered under the trajectory law generated by the
same prefix-dependent kernels. -/
theorem trajectoryRiskShortfall_condExp_eq_zero
    (K : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    [∀ n, IsMarkovKernel (K n)] (x0 : Z) {score : TrajectoryScore Z}
    (hscore : ∀ n u y, score n u y ∈ Set.Icc (0 : ℝ) 1) (k : ℕ) :
    (trajectoryMeasure K x0)[trajectoryRiskShortfall K score k |
        Filtration.piLE (X := fun _ : ℕ ↦ Z) k] =ᵐ[trajectoryMeasure K x0] 0 := by
  show (trajectoryMeasure K x0)[
      fun x ↦ -trajectoryRiskInnovation K score k x |
        Filtration.piLE (X := fun _ : ℕ ↦ Z) k] =ᵐ[trajectoryMeasure K x0] 0
  have hneg := condExp_neg (μ := trajectoryMeasure K x0)
    (m := Filtration.piLE (X := fun _ : ℕ ↦ Z) k)
    (trajectoryRiskInnovation K score k)
  refine hneg.trans ?_
  filter_upwards [trajectoryRiskInnovation_condExp_eq_zero K x0 hscore k]
    with x hx
  simp only [Pi.neg_apply, Pi.zero_apply] at hx ⊢
  rw [hx]
  simp

omit [Fintype ι] [DecidableEq ι] [Nonempty ι]
  [Fintype τ] [DecidableEq τ] [Nonempty τ] in
/-- Negation preserves the universal `1 / 4` conditional-second-moment bound. -/
theorem trajectoryRiskShortfall_condSecondMoment_le_one_fourth
    (K : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    [∀ n, IsMarkovKernel (K n)] (x0 : Z) {score : TrajectoryScore Z}
    (hscore : ∀ n u y, score n u y ∈ Set.Icc (0 : ℝ) 1) (k : ℕ) :
    (trajectoryMeasure K x0)[fun x ↦ (trajectoryRiskShortfall K score k x) ^ 2 |
        Filtration.piLE (X := fun _ : ℕ ↦ Z) k] ≤ᵐ[trajectoryMeasure K x0]
      fun _ ↦ (1 / 4 : ℝ) := by
  have hsq :
      (fun x ↦ (trajectoryRiskShortfall K score k x) ^ 2) =
        fun x ↦ (trajectoryRiskInnovation K score k x) ^ 2 := by
    funext x
    simp [trajectoryRiskShortfall]
  rw [hsq]
  exact trajectoryRiskInnovation_condSecondMoment_le_one_fourth K x0 hscore k

/-- Failure of a declared trajectory-risk tilt boundary for some posterior and
positive time. -/
def trajectoryPACBayesTiltMixtureAnyPosteriorUpperFailure
    (prior : ι → ℝ) (weight : τ → ℝ)
    (K : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    (score : ι → TrajectoryScore Z) (lam : τ → ℝ) (delta : ℝ) :
    Set (ℕ → Z) :=
  {x | ∃ j : τ, ∃ posterior : ι → ℝ, IsPMF posterior ∧
    ∃ n : ℕ, 0 < n ∧
      subGammaCgf (1 / 4) 1 (lam j) / lam j +
          (klDiv posterior prior + Real.log (1 / (delta * weight j))) /
            ((n : ℝ) * lam j) ≤
        trajectoryPosteriorAverageConditionalRisk K score posterior n x -
          trajectoryPosteriorEmpiricalPrequentialRisk score posterior n x}

omit [DecidableEq ι] [Nonempty ι]
  [Fintype τ] [DecidableEq τ] [Nonempty τ]
  [Fintype Z] [MeasurableSingletonClass Z] in
/-- A trajectory-risk failure is a failure of the generic finite
hypothesis--tilt master-process theorem. -/
theorem trajectoryPACBayesTiltMixtureAnyPosteriorUpperFailure_subset_processFailure
    {prior : ι → ℝ} {weight : τ → ℝ}
    {K : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z}
    {score : ι → TrajectoryScore Z} {lam : τ → ℝ} {delta : ℝ} :
    trajectoryPACBayesTiltMixtureAnyPosteriorUpperFailure
        prior weight K score lam delta ⊆
      PACBayes.TimeUniform.timeUniformPACBayesTiltMixtureAnyPosteriorUpperFailure
        prior weight (fun i ↦ trajectoryRiskShortfall K (score i))
          (1 / 4) 1 lam delta := by
  intro x hx
  rcases hx with ⟨j, posterior, hposterior, n, hn, hfailure⟩
  refine ⟨j, posterior, hposterior, n, hn, ?_⟩
  rw [posteriorAverage_runningMean_trajectoryRiskShortfall]
  exact hfailure

omit [DecidableEq ι] [DecidableEq τ] [Nonempty τ] in
/-- One outer-probability event controls all times, post-data posterior PMFs,
and atoms in the predeclared weighted tilt catalog. -/
theorem trajectoryPACBayes_tiltMixture_allPosteriors_bound
    (K : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    [∀ n, IsMarkovKernel (K n)] (x0 : Z)
    {score : ι → TrajectoryScore Z}
    (hscore : ∀ i n u y, score i n u y ∈ Set.Icc (0 : ℝ) 1)
    {prior : ι → ℝ} (hprior : IsFullSupportPMF prior)
    {weight : τ → ℝ} (hweight : IsFullSupportPMF weight)
    {lam : τ → ℝ} {delta : ℝ} (hdelta : 0 < delta)
    (hlam : ∀ j, 0 < lam j) (hlam_three : ∀ j, lam j < 3) :
    (trajectoryMeasure K x0).real
      (trajectoryPACBayesTiltMixtureAnyPosteriorUpperFailure
        prior weight K score lam delta) ≤ delta := by
  refine (measureReal_mono
    (trajectoryPACBayesTiltMixtureAnyPosteriorUpperFailure_subset_processFailure
      (prior := prior) (weight := weight) (K := K) (score := score)
      (lam := lam) (delta := delta))).trans ?_
  exact PACBayes.TimeUniform.timeUniformPACBayes_tiltMixture_allPosteriors_bound
    (μ := trajectoryMeasure K x0)
    (ℱ := Filtration.piLE (X := fun _ : ℕ ↦ Z))
    (prior := prior) (weight := weight)
    (X := fun i ↦ trajectoryRiskShortfall K (score i))
    (sigma2 := (1 / 4 : ℝ)) (b := (1 : ℝ))
    (lam := lam) (delta := delta) hprior hweight hdelta
    (by norm_num) (by norm_num) hlam (fun j ↦ by simpa using hlam_three j)
    (fun i k ↦ measurable_trajectoryRiskShortfall K (score i) k)
    (fun i k ↦ integrable_trajectoryRiskShortfall
      (K := K) (x0 := x0) (hscore i) k)
    (fun i ↦ trajectoryRiskShortfall_incrementAdapted K (score i))
    (fun i j n ↦
      PACBayes.TimeUniformIID.integrable_subGammaExponentialProcess_of_bounded n
        (by norm_num) (by norm_num) (hlam j).le
        (by simpa using hlam_three j)
        (fun k ↦ measurable_trajectoryRiskShortfall K (score i) k)
        (fun k ↦ Filter.Eventually.of_forall fun x ↦
          abs_trajectoryRiskShortfall_le_one K (hscore i) k x))
    (fun i k ↦ Filter.Eventually.of_forall fun x ↦
      abs_trajectoryRiskShortfall_le_one K (hscore i) k x)
    (fun i k ↦ trajectoryRiskShortfall_condExp_eq_zero K x0 (hscore i) k)
    (fun i k ↦
      trajectoryRiskShortfall_condSecondMoment_le_one_fourth K x0 (hscore i) k)

/-- Measurable hull of the posterior/tilt-existential trajectory-risk failure
set. -/
def trajectoryPACBayesTiltMixtureExceptionalEvent
    (prior : ι → ℝ) (weight : τ → ℝ)
    (K : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    [∀ n, IsMarkovKernel (K n)] (x0 : Z)
    (score : ι → TrajectoryScore Z) (lam : τ → ℝ) (delta : ℝ) :
    Set (ℕ → Z) :=
  toMeasurable (trajectoryMeasure K x0)
    (trajectoryPACBayesTiltMixtureAnyPosteriorUpperFailure
      prior weight K score lam delta)

omit [DecidableEq ι] [Nonempty ι]
  [Fintype τ] [DecidableEq τ] [Nonempty τ]
  [Fintype Z] [MeasurableSingletonClass Z] in
theorem trajectoryPACBayesTiltMixtureExceptionalEvent_measurable
    (prior : ι → ℝ) (weight : τ → ℝ)
    (K : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    [∀ n, IsMarkovKernel (K n)] (x0 : Z)
    (score : ι → TrajectoryScore Z) (lam : τ → ℝ) (delta : ℝ) :
    MeasurableSet (trajectoryPACBayesTiltMixtureExceptionalEvent
      prior weight K x0 score lam delta) :=
  measurableSet_toMeasurable _ _

omit [DecidableEq ι] [Nonempty ι]
  [Fintype τ] [DecidableEq τ] [Nonempty τ]
  [Fintype Z] [MeasurableSingletonClass Z] in
theorem trajectoryPACBayesTiltMixtureRawFailure_subset_exceptionalEvent
    (prior : ι → ℝ) (weight : τ → ℝ)
    (K : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    [∀ n, IsMarkovKernel (K n)] (x0 : Z)
    (score : ι → TrajectoryScore Z) (lam : τ → ℝ) (delta : ℝ) :
    trajectoryPACBayesTiltMixtureAnyPosteriorUpperFailure
        prior weight K score lam delta ⊆
      trajectoryPACBayesTiltMixtureExceptionalEvent
        prior weight K x0 score lam delta :=
  subset_toMeasurable _ _

omit [DecidableEq ι] [DecidableEq τ] [Nonempty τ] in
/-- The measurable common trajectory-risk event has ordinary probability at
most `delta`. -/
theorem trajectoryPACBayesTiltMixtureExceptionalEvent_mass_le_delta
    (K : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    [∀ n, IsMarkovKernel (K n)] (x0 : Z)
    {score : ι → TrajectoryScore Z}
    (hscore : ∀ i n u y, score i n u y ∈ Set.Icc (0 : ℝ) 1)
    {prior : ι → ℝ} (hprior : IsFullSupportPMF prior)
    {weight : τ → ℝ} (hweight : IsFullSupportPMF weight)
    {lam : τ → ℝ} {delta : ℝ} (hdelta : 0 < delta)
    (hlam : ∀ j, 0 < lam j) (hlam_three : ∀ j, lam j < 3) :
    (trajectoryMeasure K x0).real
      (trajectoryPACBayesTiltMixtureExceptionalEvent
        prior weight K x0 score lam delta) ≤ delta := by
  rw [trajectoryPACBayesTiltMixtureExceptionalEvent, Measure.real,
    measure_toMeasurable]
  exact trajectoryPACBayes_tiltMixture_allPosteriors_bound
    K x0 hscore hprior hweight hdelta hlam hlam_three

omit [DecidableEq ι] [Nonempty ι]
  [Fintype τ] [DecidableEq τ] [Nonempty τ]
  [Fintype Z] [MeasurableSingletonClass Z] in
/-- Outside the common event, every posterior, positive time, and declared
tilt obeys the trajectory prequential upper-risk certificate. -/
theorem trajectoryPosteriorAverageConditionalRisk_lt_tiltMixture_of_not_mem
    (prior : ι → ℝ) (weight : τ → ℝ)
    (K : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    [∀ n, IsMarkovKernel (K n)] (x0 : Z)
    (score : ι → TrajectoryScore Z)
    {lam : τ → ℝ} {delta : ℝ} {x : ℕ → Z}
    (hx : x ∉ trajectoryPACBayesTiltMixtureExceptionalEvent
      prior weight K x0 score lam delta)
    (j : τ) (posterior : ι → ℝ) (hposterior : IsPMF posterior)
    (n : ℕ) (hn : 0 < n) :
    trajectoryPosteriorAverageConditionalRisk K score posterior n x <
      trajectoryPosteriorEmpiricalPrequentialRisk score posterior n x +
        subGammaCgf (1 / 4) 1 (lam j) / lam j +
        (klDiv posterior prior + Real.log (1 / (delta * weight j))) /
          ((n : ℝ) * lam j) := by
  have hxraw : x ∉ trajectoryPACBayesTiltMixtureAnyPosteriorUpperFailure
      prior weight K score lam delta :=
    fun hraw ↦ hx
      (trajectoryPACBayesTiltMixtureRawFailure_subset_exceptionalEvent
        prior weight K x0 score lam delta hraw)
  have hgap :
      trajectoryPosteriorAverageConditionalRisk K score posterior n x -
          trajectoryPosteriorEmpiricalPrequentialRisk score posterior n x <
        subGammaCgf (1 / 4) 1 (lam j) / lam j +
          (klDiv posterior prior + Real.log (1 / (delta * weight j))) /
            ((n : ℝ) * lam j) := by
    exact lt_of_not_ge fun hfailure ↦
      hxraw ⟨j, posterior, hposterior, n, hn, hfailure⟩
  linarith

omit [DecidableEq ι] [DecidableEq τ] [Nonempty τ] in
/-- Publication-facing finite weighted-tilt trajectory PAC-Bayes certificate.
The catalog may contain arbitrary predeclared prefix-dependent scoring rules. -/
theorem trajectoryPACBayes_tiltMixture_prequentialRisk_certificate
    (K : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    [∀ n, IsMarkovKernel (K n)] (x0 : Z)
    {score : ι → TrajectoryScore Z}
    (hscore : ∀ i n u y, score i n u y ∈ Set.Icc (0 : ℝ) 1)
    {prior : ι → ℝ} (hprior : IsFullSupportPMF prior)
    {weight : τ → ℝ} (hweight : IsFullSupportPMF weight)
    {lam : τ → ℝ} {delta : ℝ} (hdelta : 0 < delta)
    (hlam : ∀ j, 0 < lam j) (hlam_three : ∀ j, lam j < 3) :
    ∃ E : Set (ℕ → Z),
      MeasurableSet E ∧
      (trajectoryMeasure K x0).real E ≤ delta ∧
      ∀ x ∉ E, ∀ j : τ,
        ∀ posterior : ι → ℝ, IsPMF posterior →
          ∀ n : ℕ, 0 < n →
            trajectoryPosteriorAverageConditionalRisk K score posterior n x <
              trajectoryPosteriorEmpiricalPrequentialRisk score posterior n x +
                lam j / (8 * (1 - lam j / 3)) +
                (klDiv posterior prior +
                  Real.log (1 / (delta * weight j))) /
                    ((n : ℝ) * lam j) := by
  let E := trajectoryPACBayesTiltMixtureExceptionalEvent
    prior weight K x0 score lam delta
  refine ⟨E, trajectoryPACBayesTiltMixtureExceptionalEvent_measurable
    prior weight K x0 score lam delta, ?_, ?_⟩
  · exact trajectoryPACBayesTiltMixtureExceptionalEvent_mass_le_delta
      K x0 hscore hprior hweight hdelta hlam hlam_three
  · intro x hx j posterior hposterior n hn
    have hbound :=
      trajectoryPosteriorAverageConditionalRisk_lt_tiltMixture_of_not_mem
        prior weight K x0 score hx j posterior hposterior n hn
    rw [subGammaCgf_oneFourth_one_div (hlam j) (hlam_three j)] at hbound
    exact hbound

end

end FormalSLT.StochasticDynamics
