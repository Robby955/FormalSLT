import FormalSLT.StochasticDynamics.TrajectoryPACBayes
import FormalSLT.PACBayes.ForwardPredictableMeanBesselPACBayes

/-!
# Empirical-Bernstein PAC-Bayes bounds for prefix-dependent trajectories

This module specializes the predictable-conditional-mean forward-Bessel
PAC-Bayes theorem to the path law generated by arbitrary prefix-dependent
kernels.  The observed process for hypothesis `i` is its one-step trajectory
score, and its predictable mean is the exact kernel-conditional risk given the
realized prefix.

One outer-mass event is simultaneous over every time `n >= 2`, every posterior
PMF on the finite predeclared score catalog, and every atom of a finite
predeclared tilt catalog.  Both the posterior and the tilt may therefore be
selected after observing the path and time.  The displayed hybrid-Bessel
penalty is computed from the observed prefix scores separately for each
hypothesis.  It is only a pointwise lower envelope of the actual e-process, not
an e-process itself.
-/

open MeasureTheory ProbabilityTheory
open FormalSLT.AnytimeValid FormalSLT.PACBayesKL
open FormalSLT.PACBayes.ForwardPredictableMeanBesselPACBayes
open scoped BigOperators

namespace FormalSLT.StochasticDynamics

noncomputable section

variable {ι τ Z : Type*}
  [Fintype ι] [DecidableEq ι] [Nonempty ι]
  [Fintype τ] [DecidableEq τ]
  [Fintype Z] [MeasurableSpace Z] [MeasurableSingletonClass Z]

omit [Fintype ι] [DecidableEq ι] [Nonempty ι]
  [Fintype τ] [DecidableEq τ] in
/-- A trajectory score is revealed at the next path coordinate. -/
theorem observedTrajectoryScore_incrementAdapted
    (score : TrajectoryScore Z) :
    IncrementAdapted (Filtration.piLE (X := fun _ : ℕ ↦ Z))
      (observedTrajectoryScore score) := by
  intro n
  exact stronglyMeasurable_observedTrajectoryScore_succ score n

omit [Fintype ι] [DecidableEq ι] [Nonempty ι]
  [Fintype τ] [DecidableEq τ] in
/-- The exact kernel-conditional risk is measurable from the current prefix. -/
theorem conditionalTrajectoryRisk_stronglyAdapted
    (K : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    (score : TrajectoryScore Z) :
    StronglyAdapted (Filtration.piLE (X := fun _ : ℕ ↦ Z))
      (conditionalTrajectoryRisk K score) := by
  intro n
  exact stronglyMeasurable_conditionalTrajectoryRisk K score n

omit [Fintype ι] [DecidableEq ι] [Nonempty ι]
  [Fintype τ] [DecidableEq τ]
  [Fintype Z] [MeasurableSpace Z] [MeasurableSingletonClass Z] in
/-- The forward prefix mean of observed trajectory scores is the prequential
empirical risk used by the trajectory API. -/
theorem forwardPrefixMean_observedTrajectoryScore
    (score : TrajectoryScore Z) (n : ℕ) (x : ℕ → Z) :
    forwardPrefixMean (fun k ↦ observedTrajectoryScore score k x) n =
      trajectoryEmpiricalPrequentialRisk score n x := by
  rfl

omit [Fintype ι] [DecidableEq ι] [Nonempty ι]
  [Fintype τ] [DecidableEq τ]
  [Fintype Z] [MeasurableSingletonClass Z] in
/-- The forward prefix mean of the predictable conditional risks is the
encountered average conditional risk used by the trajectory API. -/
theorem forwardPrefixMean_conditionalTrajectoryRisk
    (K : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    (score : TrajectoryScore Z) (n : ℕ) (x : ℕ → Z) :
    forwardPrefixMean (fun k ↦ conditionalTrajectoryRisk K score k x) n =
      trajectoryAverageConditionalRisk K score n x := by
  rfl

/-- Posterior average of the per-hypothesis observed hybrid-Bessel penalties.
The minimum inside `forwardHybridBesselPenalty` is taken before posterior
averaging. -/
def trajectoryPosteriorHybridBesselPenalty
    (posterior : ι → ℝ) (score : ι → TrajectoryScore Z)
    (n : ℕ) (x : ℕ → Z) : ℝ :=
  posteriorAverage posterior fun i ↦
    forwardHybridBesselPenalty
      (fun k ↦ observedTrajectoryScore (score i) k x) n

/-- Exact observable empirical-Bernstein boundary for a declared tilt atom. -/
def trajectoryEmpiricalBernsteinPACBayesBoundary
    (prior : ι → ℝ) (weight : τ → ℝ) (lam : τ → ℝ)
    (score : ι → TrajectoryScore Z) (posterior : ι → ℝ)
    (delta : ℝ) (j : τ) (n : ℕ) (x : ℕ → Z) : ℝ :=
  (klDiv posterior prior + Real.log (1 / (delta * weight j)) +
      forwardEmpiricalBernsteinPsi (lam j) *
        trajectoryPosteriorHybridBesselPenalty posterior score n x) /
    ((n : ℝ) * lam j)

omit [DecidableEq ι] [Nonempty ι]
  [Fintype τ] [DecidableEq τ]
  [Fintype Z] [MeasurableSpace Z] [MeasurableSingletonClass Z] in
/-- The trajectory boundary is definitionally the generic predictable-mean
boundary specialized to observed path scores. -/
theorem trajectoryEmpiricalBernsteinPACBayesBoundary_eq_generic
    (prior : ι → ℝ) (weight : τ → ℝ) (lam : τ → ℝ)
    (score : ι → TrajectoryScore Z) (posterior : ι → ℝ)
    (delta : ℝ) (j : τ) (n : ℕ) (x : ℕ → Z) :
    trajectoryEmpiricalBernsteinPACBayesBoundary
        prior weight lam score posterior delta j n x =
      forwardPredictableMeanBesselPACBayesBoundary
        prior weight lam (fun i ↦ observedTrajectoryScore (score i))
          posterior delta j n x := by
  rfl

/-- One outer-mass event controls the empirical-Bernstein trajectory
PAC-Bayes certificate at every time `n >= 2`, for every posterior PMF and every
declared tilt atom.  The event is an outer-probability package: no separate
measurability claim is made for it. -/
theorem exists_trajectoryEmpiricalBernsteinPACBayes_event
    (K : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    [∀ n, IsMarkovKernel (K n)] (x0 : Z)
    {score : ι → TrajectoryScore Z}
    (hscore : ∀ i n u y, score i n u y ∈ Set.Icc (0 : ℝ) 1)
    {prior : ι → ℝ} (hprior : IsFullSupportPMF prior)
    {weight : τ → ℝ} (hweight : IsFullSupportPMF weight)
    {lam : τ → ℝ} {delta : ℝ} (hdelta : 0 < delta)
    (hlam : ∀ j, 0 < lam j) (hlam_one : ∀ j, lam j < 1) :
    ∃ goodEvent : Set (ℕ → Z),
      (trajectoryMeasure K x0).real goodEventᶜ ≤ delta ∧
        ∀ x ∈ goodEvent, ∀ j : τ,
          ∀ posterior : ι → ℝ, IsPMF posterior →
            ∀ n : ℕ, 2 ≤ n →
              trajectoryPosteriorAverageConditionalRisk
                  K score posterior n x <
                trajectoryPosteriorEmpiricalPrequentialRisk
                    score posterior n x +
                  trajectoryEmpiricalBernsteinPACBayesBoundary
                    prior weight lam score posterior delta j n x := by
  rcases
      exists_forwardPredictableMeanBesselPACBayes_event
        (μ := trajectoryMeasure K x0)
        (ℱ := Filtration.piLE (X := fun _ : ℕ ↦ Z))
        (prior := prior) hprior (weight := weight) hweight
        (X := fun i ↦ observedTrajectoryScore (score i))
        (mean := fun i ↦ conditionalTrajectoryRisk K (score i))
        (lam := lam) (delta := delta) hdelta hlam hlam_one
        (fun i ↦ observedTrajectoryScore_incrementAdapted (score i))
        (fun i ↦ conditionalTrajectoryRisk_stronglyAdapted K (score i))
        (fun i k x ↦ observedTrajectoryScore_mem_Icc (hscore i) k x)
        (fun i k ↦ observedTrajectoryScore_condExp K x0 (score i) (hscore i) k)
    with ⟨goodEvent, hmass, hgood⟩
  refine ⟨goodEvent, hmass, ?_⟩
  intro x hx j posterior hposterior n hn
  have hbound := hgood x hx j posterior hposterior n hn
  simpa only [forwardPrefixMean_observedTrajectoryScore,
    forwardPrefixMean_conditionalTrajectoryRisk,
    trajectoryPosteriorAverageConditionalRisk,
    trajectoryPosteriorEmpiricalPrequentialRisk,
    trajectoryAverageConditionalRisk,
    trajectoryEmpiricalPrequentialRisk,
    trajectoryEmpiricalBernsteinPACBayesBoundary_eq_generic] using hbound

/-- The common event permits path-, time-, and posterior-dependent selection
of both a posterior and a predeclared tilt atom.  This is pointwise selection
from the uniform theorem, not construction of a selected e-process. -/
theorem exists_trajectoryEmpiricalBernsteinPACBayes_selected_event
    (K : (n : ℕ) → Kernel ((i : Finset.Iic n) → Z) Z)
    [∀ n, IsMarkovKernel (K n)] (x0 : Z)
    {score : ι → TrajectoryScore Z}
    (hscore : ∀ i n u y, score i n u y ∈ Set.Icc (0 : ℝ) 1)
    {prior : ι → ℝ} (hprior : IsFullSupportPMF prior)
    {weight : τ → ℝ} (hweight : IsFullSupportPMF weight)
    {lam : τ → ℝ} {delta : ℝ} (hdelta : 0 < delta)
    (hlam : ∀ j, 0 < lam j) (hlam_one : ∀ j, lam j < 1)
    (posterior : (ℕ → Z) → ℕ → ι → ℝ)
    (hposterior : ∀ x n, IsPMF (posterior x n))
    (select : (ℕ → Z) → ℕ → (ι → ℝ) → τ) :
    ∃ goodEvent : Set (ℕ → Z),
      (trajectoryMeasure K x0).real goodEventᶜ ≤ delta ∧
        ∀ x ∈ goodEvent, ∀ n : ℕ, 2 ≤ n →
          trajectoryPosteriorAverageConditionalRisk
              K score (posterior x n) n x <
            trajectoryPosteriorEmpiricalPrequentialRisk
                score (posterior x n) n x +
              trajectoryEmpiricalBernsteinPACBayesBoundary
                prior weight lam score (posterior x n) delta
                  (select x n (posterior x n)) n x := by
  rcases exists_trajectoryEmpiricalBernsteinPACBayes_event
      K x0 hscore hprior hweight hdelta hlam hlam_one with
    ⟨goodEvent, hmass, hgood⟩
  refine ⟨goodEvent, hmass, ?_⟩
  intro x hx n hn
  exact hgood x hx (select x n (posterior x n))
    (posterior x n) (hposterior x n) n hn

end

end FormalSLT.StochasticDynamics
