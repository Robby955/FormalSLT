/-- Exact score and squared-score histogram certificates for physical states
nine through eleven. -/
theorem certificates09To11 :
    RowCertificate (9 : PhysicalState) ∧
      RowCertificate (10 : PhysicalState) ∧
        RowCertificate (11 : PhysicalState) :=
  ⟨certificate_9, certificate_10, certificate_11⟩

end

end FormalSLT.Applications.ControlledQueue
