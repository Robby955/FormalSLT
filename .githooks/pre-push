#!/usr/bin/env bash
# Pre-push hook for FormalSLT.
#
# Blocks two categories of leak before they reach origin:
#   1. AI attribution in commit messages (Co-Authored-By trailers,
#      "Generated with Claude Code" markers, robot emoji).
#   2. Internal workflow vocabulary, vendor names used as workflow tools,
#      and absolute internal paths in the diff content.
#
# Only checks commits being pushed (HEAD vs origin/main) and the file
# diff in those commits; existing pre-existing strings on origin/main
# are not re-scanned.
#
# Bypass with `--no-verify` for genuine technical needs only. The
# allowlist below carves out terms that ARE legitimate library content
# (Lean axiom names, the literal word "sorry" as a Lean keyword,
# the author byline).

set -e

# Soft warning: branch is far behind main.
BEHIND=$(git rev-list --count HEAD..origin/main 2>/dev/null || echo 0)
if [ "$BEHIND" -gt 50 ]; then
  echo ""
  echo "pre-push WARNING: this branch is $BEHIND commits behind origin/main."
  echo "                  Long-lived branches drift and become hard to merge."
  echo "                  Consider: git rebase origin/main, or restart from main."
  echo ""
fi

# ---------------------------------------------------------------------------
# Gate 1: AI attribution in commit messages.
# ---------------------------------------------------------------------------
ATTRIBUTION_RE='Co-Authored-By:.*(Claude|Anthropic|GPT|OpenAI|Copilot|noreply@anthropic\.com)|Generated with .*Claude Code|🤖 Generated with'
if git log --pretty=%B "origin/main..HEAD" 2>/dev/null | grep -qE "$ATTRIBUTION_RE"; then
  echo ""
  echo "pre-push: BLOCKED — AI attribution found in commit message(s)."
  echo ""
  git log --pretty='format:  %h %s' "origin/main..HEAD" | head -10
  echo ""
  echo ""
  echo "          Rewrite the commit message and re-push:"
  echo "            git commit --amend       (for the most recent commit)"
  echo "            git rebase -i origin/main  (for older commits)"
  echo ""
  echo "          Bypass only in a true emergency: git push --no-verify"
  exit 1
fi

# ---------------------------------------------------------------------------
# Gate 2: Workflow vocabulary, AI vendor names as tooling, internal paths
# in the diff content (added lines and commit bodies).
# ---------------------------------------------------------------------------
# The allowlist below is matched FIRST. If a hit line matches an allowlist
# regex, the hit is suppressed. This carves out legitimate Lean keywords
# and the author byline.
ALLOW_RES=(
  '\bsorry\b'                                # Lean keyword, library subject matter
  '\bsorryCount\b'                           # Lean tactic count
  '\b(?:propext|Classical\.choice|Quot\.sound)\b' # Lean axiom names
  'Robby Sneiderman'                         # Author byline
)

# Deny patterns. Hits in added lines or commit bodies BLOCK the push.
DENY_RES=(
  # AI vendor names used as workflow tooling (not as subject matter).
  '\bClaude\b'
  '\bAnthropic\b'
  '\bCodex\b'
  '\bOpus\b'
  '\bSonnet\b'
  '\bHaiku\b'
  '\bChatGPT\b'
  '\bOpenAI\b'
  '\bCopilot\b'
  # Internal workflow vocabulary.
  '\bCowork\b'
  '\borchestrat(?:or|ion|ed|ing)\b'
  '\bsub-?agent(s)?\b'
  '\bsuperpowers\b'
  '\bsuperpowers:'
  '\bagentic workers?\b'
  '\bvoice[- ]gate\b'
  '\bartifact[- ]or[- ]don.?t\b'
  '\bTier-1 panel\b'
  '\bworkflow-drafted\b'
  '\bagent-driven\b'
  '\bdispatched? agent\b'
  # Internal paths and filenames.
  '/Users/robsneiderman/'
  '/sessions/'
  '\bAI4MATH\b'
  '\bHQ/[A-Z]'
  '\bagent/memory/'
  '\bfeedback_[a-z]'
  '\bMEMORY\.md\b'
  '\bL0_HOT\b'
  '\bARTIFACT_TYPE:'
  '\bpre_send_haiku\b'
  '\boutbox_flush\b'
  '\benqueue\.sh\b'
  # Trailer pattern (also caught by Gate 1, but double-cover for safety
  # in case the trailer ends up in a diffed file).
  'Co-Authored-By:.*(Claude|Anthropic|GPT|OpenAI|Copilot|noreply@anthropic\.com)'
)

# Build a single grep regex of allow patterns and a single regex of deny
# patterns. Python regex syntax compiled to ERE-ish; grep -E handles
# most of these (lookaheads / non-capturing groups are fine in grep -P,
# so the hook uses -P).
ALLOW_RE=$(IFS='|'; echo "${ALLOW_RES[*]}")
DENY_RE=$(IFS='|'; echo "${DENY_RES[*]}")

# Collect the diff of added lines plus commit message bodies into one buffer.
# Exclude the hook's own dir: the hook and its README necessarily contain the
# forbidden vendor strings / path examples (as patterns + docs), so scanning them
# would block every push of the hook itself.
ADDED_LINES=$(git diff "origin/main..HEAD" -- . ':(exclude).githooks/' 2>/dev/null | grep -E '^\+' | grep -vE '^\+\+\+' || true)
COMMIT_BODIES=$(git log --pretty=%B "origin/main..HEAD" 2>/dev/null || true)
COMBINED=$(printf '%s\n%s\n' "$ADDED_LINES" "$COMMIT_BODIES")

# Find deny hits, then drop lines that ALSO match the allowlist. The deny/allow
# patterns use PCRE features (\b, non-capturing groups), so use perl — macOS BSD
# grep has no -P and silently fails open (the previous `grep -P ... 2>/dev/null ||
# true` never blocked on a Mac). Patterns are passed via env to avoid shell quoting
# issues; an empty allowlist must NOT match-everything-and-drop-all.
HITS=$(printf '%s\n' "$COMBINED" \
  | DENY_RE="$DENY_RE" perl -ne 'print "$.:$_" if /$ENV{DENY_RE}/' \
  | ALLOW_RE="$ALLOW_RE" perl -ne 'print unless length($ENV{ALLOW_RE}) && /$ENV{ALLOW_RE}/')

if [ -n "$HITS" ]; then
  echo ""
  echo "pre-push: BLOCKED — workflow / vendor / internal-path tells found."
  echo ""
  echo "$HITS" | head -20
  echo ""
  echo "          Rewrite the offending lines or commit message(s) and re-push."
  echo "          Bypass only in a true emergency: git push --no-verify"
  exit 1
fi

exit 0
